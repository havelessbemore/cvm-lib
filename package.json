{
  "$schema": "http://json.schemastore.org/package.json",
  "name": "cvm-lib",
  "version": "0.1.2",
  "description": "Estimate the number of distinct values in a set using the simple and space-efficient CVM algorithm",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/havelessbemore/cvm-lib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/havelessbemore/cvm-lib.git"
  },
  "bugs": {
    "url": "https://github.com/havelessbemore/cvm-lib/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/havelessbemore"
  },
  "author": {
    "name": "Michael Rojas",
    "url": "https://github.com/havelessbemore"
  },
  "keywords": [
    "algorithm",
    "cardinality estimation",
    "count distinct",
    "cvm",
    "distinct",
    "estimate",
    "estimator",
    "sampling",
    "streaming",
    "unique"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/esm/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.6"
  },
  "scripts": {
    "bench": "tsx ./benchmarks/bench.ts",
    "build": "tsup",
    "build:docs": "typedoc",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@eslint/json": "^0.13.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.11",
    "cross-env": "^10.0.0",
    "esbuild": "^0.25.4",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.9",
    "typedoc-plugin-markdown": "^4.8.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
